<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        API 31 split the old BLUETOOTH permission into SCAN/CONNECT. The legacy
        pair stays declared with maxSdkVersion so the app still works on older
        Android, where scanning also requires location.

        BLUETOOTH_SCAN carries neverForLocation: this app never derives location
        from scan results.

        FINE_LOCATION is no longer maxSdkVersion-limited. On Android 11 and below
        it is still required to scan; on every version it is also what makes GPS
        speed available as a fallback for hill assist. It is requested at runtime
        only when hill assist is switched on, and the feature works without it
        (the bike's own speed sensor is the primary source).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
            configChanges keeps the activity from being recreated on rotation.
            The BLE connection lives in this activity, so a recreate would drop
            the link - and a phone on the bars gets rotated.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
